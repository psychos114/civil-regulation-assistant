# 复制本文件为 .env，然后只填写真实密钥。不要把 .env 上传到 GitHub。
DATABASE_PATH=regulations.db
CORS_ORIGINS=*

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash

FAISS_INDEX_PATH=data/faiss.index
FAISS_METADATA_PATH=data/faiss_metadata.json
FAISS_DIMENSION=1024
FAISS_MIN_SCORE=0.08

CHAT_REQUESTS_PER_HOUR=20
